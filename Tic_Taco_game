def print_board(board):
    """Prints the current state of the 3x3 game board."""
    print("\n")
    print(f" {board[0]} | {board[1]} | {board[2]} ")
    print("---|---|---")
    print(f" {board[3]} | {board[4]} | {board[5]} ")
    print("---|---|---")
    print(f" {board[6]} | {board[7]} | {board[8]} ")
    print("\n")

def check_winner(board, player):
    """Checks if the given player has won the game."""
    # Define all 8 possible winning combinations (rows, columns, diagonals)
    win_conditions = [
        [0, 1, 2], [3, 4, 5], [6, 7, 8],  # Horizontal rows
        [0, 3, 6], [1, 4, 7], [2, 5, 8],  # Vertical columns
        [0, 4, 8], [2, 4, 6]              # Diagonals
    ]
    for condition in win_conditions:
        if board[condition[0]] == board[condition[1]] == board[condition[2]] == player:
            return True
    return False

def check_draw(board):
    """Checks if the board is full, meaning the game is a draw."""
    return all(space in ["X", "O"] for space in board)

def play_game():
    """Orchestrates the Tic-Tac-Toe gameplay loop."""
    # Initialize the board with positions 1 through 9
    board = [str(i) for i in range(1, 10)]
    current_player = "X"
    
    print("Welcome to Tic-Tac-Toe!")
    print("To make a move, enter the number (1-9) corresponding to the board space.")

    while True:
        print_board(board)
        
        # Safe input validation loop
        try:
            choice = int(input(f"Player {current_player}'s turn. Choose a position (1-9): "))
            position = choice - 1
            
            if choice < 1 or choice > 9:
                print("Invalid input! Please choose a number between 1 and 9.")
                continue
            if board[position] in ["X", "O"]:
                print("That position is already taken! Try another space.")
                continue
        except ValueError:
            print("Invalid input! Please enter a valid number.")
            continue

        # Place the player's marker
        board[position] = current_player

        # Check for a win
        if check_winner(board, current_player):
            print_board(board)
            print(f"Congratulations! Player {current_player} wins! 🎉")
            break

        # Check for a tie
        if check_draw(board):
            print_board(board)
            print("It's a draw! 🤝")
            break

        # Alternate turns between X and O
        current_player = "O" if current_player == "X" else "X"

if __name__ == "__main__":
    play_game()
